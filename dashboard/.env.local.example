# ============================================================
# Stackd Content Engine — Dashboard environment
# Copy to .env.local and fill in. The dashboard runs WITHOUT
# these set (it falls back to rich placeholder data), so you can
# explore the UI before wiring Supabase.
# ============================================================

# Supabase (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used by /api routes that write to the DB
SUPABASE_SERVICE_ROLE_KEY=

# Pipeline trigger — the /api/run-pipeline route forwards here.
# Point this at your /pipeline runner (local node server or queue).
# Also used to derive the base URL for the OAuth Connect endpoints
# (/api/oauth/*), which proxy to the pipeline's /oauth/* routes.
PIPELINE_WEBHOOK_URL=

# This dashboard's own public origin — used to build the exact redirect_uri
# passed to each platform's OAuth Connect flow (must match what's registered
# in that platform's app console, e.g. http://localhost:3030/api/oauth/youtube/callback
# for local dev). Defaults to http://localhost:3030 (this app's dev port) if unset.
APP_URL=

# Used by AI features invoked from the dashboard (calendar plan,
# newsletter draft, weekly insight). Server-only.
ANTHROPIC_API_KEY=

# Sent as `Authorization: Bearer <secret>` when /api/run-pipeline forwards to
# the pipeline server. Must match the pipeline's own PIPELINE_SHARED_SECRET
# (pipeline/.env) — set both before deploying beyond localhost, otherwise
# POST /run on the pipeline server is unauthenticated. Server-only.
PIPELINE_SHARED_SECRET=
