# ============================================================
# Stackd Content Engine — Pipeline environment
# Copy to pipeline/.env and fill in. EVERY key is optional:
# any integration without its key logs a warning and returns a
# well-formed mock so the full pipeline still runs and writes to
# Supabase. Add keys to flip each piece from demo -> live.
# ============================================================

# --- Core AI ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6      # optional override

# --- Voice (ElevenLabs) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Supabase (use the SERVICE ROLE key — server side, full write) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM=Stackd Studios <hello@stackdstudiosai.com>

# --- Media + images ---
PEXELS_API_KEY=
OPENAI_API_KEY=                        # DALL·E 3 thumbnails

# --- Trends / search grounding ---
YOUTUBE_API_KEY=                       # YouTube Data API v3 (trends signal)
SEARCH_API_KEY=                        # Brave Search API (what's-trending-now)

# --- Platform posting (OAuth) ---
# NOTE on analytics (pullAnalytics.js): the tokens below are reused as-is for
# pulling real metrics, but analytics reads need a BROADER SCOPE than posting
# alone — if pullAnalytics logs a 403/permission error for a platform, re-run
# that platform's OAuth consent with the scope noted and refresh the token.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
YOUTUBE_REFRESH_TOKEN=                 # obtained once via the OAuth consent flow
                                        # analytics needs the extra scope: yt-analytics.readonly
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=                   # analytics needs the extra scope: video.list
INSTAGRAM_ACCESS_TOKEN=                # analytics needs the extra scope: instagram_manage_insights (Business/Creator account only)
INSTAGRAM_ACCOUNT_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=            # analytics needs the extra scope: read_insights

# --- Notifications ---
SLACK_WEBHOOK_URL=

# --- Engine behavior ---
PIPELINE_DEMO=false                    # force mock mode even if keys exist
DASHBOARD_URL=http://localhost:3030    # used in approval links
VIRALITY_THRESHOLD=6                   # overrides config/settings.json
PORT=4040                              # pipeline HTTP trigger server

# --- Security (set before this server is reachable off localhost) ---
# Shared secret required as `Authorization: Bearer <secret>` on POST /run.
# Must match the dashboard's own PIPELINE_SHARED_SECRET (dashboard/.env.local)
# — the dashboard's /api/run-pipeline route sends it automatically. Left
# blank, /run stays open (matches local zero-config dev), but a startup
# warning is logged.
PIPELINE_SHARED_SECRET=

# Browser Origin allowed to call the public POST /lead capture endpoint
# (hit directly by visitors on the lead-magnet landing page, so it can't be
# gated behind login). Defaults to https://stackdstudiosai.com if unset.
LEAD_CAPTURE_ALLOWED_ORIGIN=https://stackdstudiosai.com
