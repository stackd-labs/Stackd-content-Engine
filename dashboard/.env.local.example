# ============================================================
# Stackd Content Engine — Dashboard environment
# Copy to .env.local and fill in. The dashboard runs WITHOUT
# these set (it falls back to rich placeholder data), so you can
# explore the UI before wiring Supabase.
# ============================================================

# Supabase (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used by /api routes that write to the DB
SUPABASE_SERVICE_ROLE_KEY=

# Pipeline trigger — the /api/run-pipeline route forwards here.
# Point this at your /pipeline runner (local node server or queue).
PIPELINE_WEBHOOK_URL=

# Used by AI features invoked from the dashboard (calendar plan,
# newsletter draft, weekly insight). Server-only.
ANTHROPIC_API_KEY=
